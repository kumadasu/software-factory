{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["factory/**/*.ts"],
  "exclude": ["factory/__fixtures__/**", "factory/runtime/**"]
}
